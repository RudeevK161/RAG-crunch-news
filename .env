# Qdrant configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="Octen-par-ch"

# Model configuration
EMBEDDING_MODEL="Octen/Octen-Embedding-0.6B"
MODE="api"
API_MODEL="qwen/qwen-2.5-7b-instruct"
API_KEY = ""

# Search defaults
SEARCH_TOP_K=3
SEARCH_FRESHNESS_WEIGHT=0.3
SEARCH_RELEVANCE_WEIGHT=0.7
SEARCH_MAX_DAYS=120
SEARCH_SCORE_THRESHOLD=0.0

# Search logging
SEARCH_LOG_FILE=search.log
SEARCH_LOG_LEVEL=INFO

# tg bot
BOT_TOKEN=''